{
  "name": "crix",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Crix: streaming coding-agent harness for terminal. OpenAI ChatGPT OAuth + Ollama Cloud 3-slot parallel.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b packages/protocol packages/core packages/tools packages/cli",
    "check": "tsc -b packages/protocol packages/core packages/tools packages/cli --pretty false",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "crix": "node packages/cli/dist/entry.js",
    "verify": "pnpm check && pnpm test",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
