{
  "name": "@ares/plugins",
  "version": "0.3.0-alpha.1",
  "description": "Reversible plugin kernel for Ares — mount, unmount, and hot-swap capabilities at runtime with every side effect rolled back on removal.",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
