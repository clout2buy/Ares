{
  "name": "@ares/tools",
  "version": "0.3.0-alpha.1",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Ares v2 tool library. One file per tool; each owns its zod schema, permission check, execution, and display.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ares/protocol": "workspace:*",
    "@ares/core": "workspace:*",
    "ical.js": "^2.2.1",
    "imapflow": "^2.1.2",
    "mailparser": "^3.9.32",
    "nodemailer": "^10.0.13",
    "pdfjs-dist": "^4.10.38",
    "tsdav": "^2.3.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2"
  }
}
